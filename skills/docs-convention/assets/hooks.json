{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node scripts/docs-guard.mjs" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node scripts/check-docs.mjs --stop" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "git config core.hooksPath .githooks" }]
      }
    ]
  }
}
